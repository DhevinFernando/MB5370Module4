//select single image from NOAA dataset and filter by arbitrary day and scale the sst values
var singleDaySST = ee.ImageCollection("NOAA/CDR/OISST/V2_1")
  .filterDate('2026-06-01', '2026-06-02')
  .first()
  .select('sst')
  .multiply(0.01); // Scale factor for NOAA OISST

print(singleDaySST)
// Define color palette and temperature range (°C)
var visParams = {
  min: 0,
  max: 30,
  palette: ['000000', '005aff', '43c8c8', 'fff700', 'ff0000']
};

// add map layer
Map.addLayer(singleDaySST, visParams, 'SST (°C)');

